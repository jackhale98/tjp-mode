;; KEYMAP
;; ============================================================================

(defalias 'tjp-xref-go-back
  (if (fboundp 'xref-go-back) 'xref-go-back 'xref-pop-marker-stack)
  "Return to the position `xref-find-definitions' was invoked from.
`xref-pop-marker-stack' is obsolete since Emacs 29.1; this picks
whichever command the running Emacs provides.")

(defvar tjp-mode-map
  (let ((map (make-sparse-keymap)))
    ;; Compilation
    (define-key map (kbd "C-c C-c") 'tjp-compile)
    (define-key map (kbd "C-c C-v") 'tjp-compile-and-view)
    (define-key map (kbd "C-c C-k") 'tjp-validate-buffer)

    ;; Navigation
    (define-key map (kbd "C-c C-n") 'tjp-next-block)
    (define-key map (kbd "C-c C-p") 'tjp-previous-block)
    (define-key map (kbd "C-c C-j") 'tjp-find-include-at-point)
    (define-key map (kbd "M-.") 'xref-find-definitions)
    (define-key map (kbd "M-,") 'tjp-xref-go-back)

    ;; Folding
    (define-key map (kbd "C-c C-f") 'tjp-toggle-fold)
    (define-key map (kbd "C-c C-a") 'tjp-fold-all)
    (define-key map (kbd "C-c C-o") 'tjp-unfold-all)

    ;; Templates
    (define-key map (kbd "C-c C-i") 'tjp-insert-task)
    (define-key map (kbd "C-c C-r") 'tjp-insert-resource)
    (define-key map (kbd "C-c C-R") 'tjp-insert-report)
    (define-key map (kbd "C-c C-d") 'tjp-insert-date-prompt)

    ;; Structure and Analysis
    (define-key map (kbd "C-c C-s") 'tjp-show-structure)
    (define-key map (kbd "C-c C-=") 'tjp-show-statistics)

    ;; Tags
    (define-key map (kbd "C-c C-t") 'tjp-generate-tags)

    ;; Documentation
    (define-key map (kbd "C-c C-h") 'tjp-show-help)

    ;; Analysis
    (define-key map (kbd "C-c C-y") 'tjp-show-dependencies)
    (define-key map (kbd "C-c C-l") 'tjp-show-resource-allocation)

    map)
  "Keymap for TaskJuggler mode.")

;; ============================================================================
;; MODE DEFINITION
;; ============================================================================

;;;###autoload
(define-derived-mode tjp-mode prog-mode "TJP"
  "Major mode for editing TaskJuggler project files.

Key bindings:
\\{tjp-mode-map}"
  :syntax-table tjp-mode-syntax-table

  ;; Font locking
  (setq-local font-lock-defaults '(tjp-font-lock-keywords nil nil))

  ;; Comments
  (setq-local comment-start "# ")
  (setq-local comment-end "")
  (setq-local comment-start-skip "\\(?:#+\\|//+\\)[ \t]*")

  ;; Multi-line strings and macro bodies need syntax properties: see
  ;; `tjp-syntax-propertize'.
  (setq-local syntax-propertize-function #'tjp-syntax-propertize)
  (setq-local parse-sexp-lookup-properties t)

  ;; Indentation
  (setq-local indent-line-function 'tjp-indent-line)
  (setq-local electric-indent-chars
              (append "{}[]" (default-value 'electric-indent-chars)))

  ;; Compilation.  This is a plausible default that also serves as the marker
  ;; for "the user has not overridden `compile-command'"; `tjp-compile'
  ;; recomputes it from the resolved tj3 path and `tjp-project-file'.
  (setq tjp--auto-compile-command
        (concat tjp-compiler-command " --silent "
                (if buffer-file-name
                    (shell-quote-argument buffer-file-name)
                  "")))
  (setq-local compile-command tjp--auto-compile-command)

  ;; Enhanced error navigation
  (tjp-setup-compilation)

  ;; Folding support - use hideshow for brace-aware folding
  (tjp-setup-hideshow)
  (hs-minor-mode 1)

  ;; Xref backend
  (add-hook 'xref-backend-functions #'tjp-xref-backend nil t)

  ;; Imenu
  (setq-local imenu-create-index-function #'tjp--imenu-create-index)

  ;; Eldoc.  `eldoc-documentation-functions' is the documented hook; the
  ;; old `eldoc-documentation-function' is an alias for the display
  ;; *strategy* since Emacs 28, so advising it would override the user's
  ;; choice and mask every other eldoc backend.
  (add-hook 'eldoc-documentation-functions #'tjp-eldoc-function nil t)
  (eldoc-mode 1)

  ;; Completion at point
  (add-hook 'completion-at-point-functions #'tjp-completion-at-point nil t)

  ;; Cleanup whitespace on save
  (add-hook 'before-save-hook 'tjp-cleanup-whitespace nil t)

  ;; Auto-validation.  The hook itself checks `tjp-auto-validate', so
  ;; toggling the option takes effect without reopening the file.
  (add-hook 'after-save-hook 'tjp-validate-on-save nil t)

  ;; Outline mode setup
  (tjp-setup-outline)

  ;; Try to setup optional features
  (tjp-setup-flycheck))

