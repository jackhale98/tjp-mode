;; Helper Functions for Shell Execution
;; ============================================================================

(defvar tjp--command-cache (make-hash-table :test 'equal)
  "Memoized results of `tjp--resolve-command', keyed by command name.")

(defun tjp--ask-login-shell (command)
  "Ask the user's login shell for the absolute path of COMMAND.
Returns nil when the shell cannot find it.  A GUI Emacs typically does
not inherit the PATH exported by the user's shell startup files, and
this is the one place the mode pays for a login shell - the answer is
cached, so it happens at most once per command per session."
  (let ((shell (or (getenv "SHELL") shell-file-name)))
    (when (and shell (file-executable-p shell))
      (with-temp-buffer
        (when (eq 0 (ignore-errors
                      (call-process shell nil t nil "-lc"
                                    (format "command -v %s"
                                            (shell-quote-argument command)))))
          ;; A login shell may print a banner first; the answer is the last
          ;; non-empty line it wrote.
          (let* ((lines (split-string (buffer-string) "\n" t "[ \t\r]+"))
                 (path (car (last lines))))
            (and path (file-executable-p path) path)))))))

(defun tjp--resolve-command (command)
  "Return the absolute path of COMMAND, or nil if it cannot be found."
  (let ((cached (gethash command tjp--command-cache 'missing)))
    (if (not (eq cached 'missing))
        cached
      (puthash command
               (or (and (file-name-absolute-p command)
                        (file-executable-p command)
                        command)
                   (executable-find command)
                   (tjp--ask-login-shell command))
               tjp--command-cache))))

