(defun tjp-insert-date ()
  "Insert current date in TaskJuggler format (YYYY-MM-DD)."
  (interactive)
  (insert (format-time-string "%Y-%m-%d")))

(defun tjp-insert-datetime ()
  "Insert current datetime in TaskJuggler format."
  (interactive)
  (insert (format-time-string "%Y-%m-%d-%H:%M")))

(defun tjp-insert-date-prompt ()
  "Prompt for and insert a date using org-mode's date picker if available."
  (interactive)
  (if (require 'org nil t)
      (let ((date (org-read-date nil nil nil "Select date: ")))
        (insert date))
    (call-interactively 'tjp-insert-date)))

