;; Package-Requires: ((emacs "27.1"))
;; URL: https://github.com/jackhale98/tjp-mode

;; The keyword lists were originally generated by TaskJuggler's
;; EmacsLispSyntax.rb and have been checked against `tj3man'.
;; Features: tag navigation, ID completion, context help, advanced folding,
;; include navigation, dependency visualization, resource allocation tracking,
;; macro expansion, validation, and project statistics

;;; Commentary:

;; This major mode provides comprehensive support for editing TaskJuggler 3
;; project files (.tjp, .tji).
;;
;; Features:
;; - Comprehensive syntax highlighting for all TJ3 keywords
;; - Intelligent indentation
;; - Advanced code folding (hideshow-mode)
;; - Tag navigation with xref (M-. to jump to definitions)
;; - imenu integration for quick navigation
;; - ID completion at point with company-mode support
;; - eldoc integration (shows hierarchical IDs)
;; - Context-sensitive help (tj3man integration)
;; - Enhanced error navigation with flycheck support
;; - Integration with tj3 compiler (via compile command)
;; - Include file navigation
;; - Date/time insertion helpers
;; - Hierarchical structure browser
;; - Macro expansion and navigation
;; - Dependency visualization
;; - Resource allocation display
;; - Live syntax validation
;; - Project statistics
;; - Comment handling
;; - Optional whitespace cleanup on save
;;
;; Installation:
;;   git clone https://github.com/jackhale98/tjp-mode.git
;;   (add-to-list 'load-path "/path/to/tjp-mode")
;;   (require 'tjp-mode)
;;   ;; .tjp and .tji files auto-activate - no auto-mode-alist entry needed
;;
;;   Evil, Doom and Spacemacs users get `SPC m' (or `,') bindings
;;   automatically: `tjp-mode' loads `tjp-evil' when it is on the load
;;   path, and that file does nothing unless evil is present.  See the
;;   README for straight.el, elpaca, package-vc and Doom recipes.
;;
;; Key Bindings:
;;   C-c C-c     - Compile project
;;   C-c C-v     - Compile and view HTML
;;   C-c C-k     - Validate buffer syntax
;;   M-.         - Jump to task/resource definition
;;   M-,         - Pop back from definition
;;   C-c C-j     - Jump to include file
;;   C-c C-n     - Next block
;;   C-c C-p     - Previous block
;;   C-c C-f     - Toggle folding at point
;;   C-c C-a     - Fold all blocks
;;   C-c C-o     - Unfold all blocks
;;   C-c C-i     - Insert task template
;;   C-c C-r     - Insert resource template
;;   C-c C-d     - Insert date
;;   C-c C-s     - Show structure browser
;;   C-c C-t     - Generate tags file
;;   C-c C-=     - Show project statistics
;;   C-c C-h     - Documentation for the keyword at point (tj3man)
;;   C-c C-y     - Show the dependency chain of the task at point
;;   C-c C-l     - Show resource allocations
;;
;; Multi-file projects:
;;   tj3 only accepts a master `.tjp' file, so when editing an included
;;   `.tji' point the mode at the project it belongs to:
;;
;;     ;; .dir-locals.el
;;     ((tjp-mode . ((tjp-project-file . "project.tjp"))))
;;
;;   For Doom Emacs users: Use SPC m (localleader) for all commands
;;   See configuration example in the README.

