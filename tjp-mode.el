;; Font Lock Configuration
;; ============================================================================

(defconst tjp-font-lock-keywords
  (let* ((properties-regexp (regexp-opt tjp-properties 'words))
         (attributes-regexp (regexp-opt tjp-attributes 'words))
         (special-regexp (regexp-opt tjp-special-keywords 'words)))
    `(
      ;; Comments and strings (including -8<- ... ->8- blocks) are handled
      ;; syntactically, by the syntax table and `tjp-syntax-propertize'.

      ;; Dates: YYYY-MM-DD or YYYY-MM-DD-HH:MM
      (,"\\<[0-9]\\{4\\}-[0-9]\\{1,2\\}-[0-9]\\{1,2\\}\\(?:-[0-9]\\{1,2\\}:[0-9]\\{1,2\\}\\(?::[0-9]\\{1,2\\}\\)?\\(?:-[-+]?[0-9]\\{4\\}\\)?\\)?\\>" . font-lock-constant-face)

      ;; Times: HH:MM or HH:MM:SS
      (,"\\<[0-9]\\{1,2\\}:[0-9]\\{2\\}\\(?::[0-9]\\{2\\}\\)?\\>" . font-lock-constant-face)

      ;; Numbers with optional units: 123, 123.45, 123d, 123h, 123w, 123m, 123y, 123min
      (,"\\<[-+]?[0-9]+\\(?:\\.[0-9]+\\)?\\(?:[hdwmy]\\|min\\)?\\>" . font-lock-constant-face)

      ;; Macro variables: ${...}
      (,"\\${[^}]*}" . font-lock-variable-name-face)

      ;; Include statements
      (,"\\<include\\s-+.*$" . font-lock-preprocessor-face)

      ;; Special keywords (macro, project, supplement)
      (,special-regexp . font-lock-preprocessor-face)

      ;; Properties (task, resource, report types)
      (,properties-regexp . font-lock-function-name-face)

      ;; Attributes
      (,attributes-regexp . font-lock-keyword-face)))
  "Font lock keywords for TaskJuggler mode.")

;; Syntax Table
;; ============================================================================

(defvar tjp-mode-syntax-table
  (let ((st (make-syntax-table)))
    ;; Comments
    (modify-syntax-entry ?# "<" st)   ; # starts a comment
    (modify-syntax-entry ?\n ">" st)  ; newline ends a comment
    (modify-syntax-entry ?/ ". 124" st) ; / can start // or /* comments
    (modify-syntax-entry ?* ". 23b" st) ; * is part of /* */ comments

    ;; Strings.  TaskJuggler also accepts single-quoted strings, but treating
    ;; ' as a string delimiter would break on the apostrophes that occur in
    ;; ordinary prose, so it stays punctuation and 'foo' is not highlighted.
    ;; Multi-line -8<- ... ->8- strings are handled by `tjp-syntax-propertize'.
    (modify-syntax-entry ?\" "\"" st)
    (modify-syntax-entry ?' "." st)

    ;; Operators and punctuation
    (modify-syntax-entry ?{ "(}" st)
    (modify-syntax-entry ?} "){" st)
    (modify-syntax-entry ?\[ "(]" st)
    (modify-syntax-entry ?\] ")[" st)

    ;; Word constituents
    (modify-syntax-entry ?_ "_" st)
    ;; TaskJuggler IDs are [a-zA-Z_]\w* and never contain a hyphen, so `-'
    ;; is punctuation: as a symbol constituent it would make
    ;; `thing-at-point' return whole dates such as 2026-01-31 as the
    ;; "identifier" at point, which xref, eldoc and tj3man all choke on.
    (modify-syntax-entry ?- "." st)
    (modify-syntax-entry ?. "_" st) ; Allow dots in identifiers (for hierarchical IDs)

    st)
  "Syntax table for `tjp-mode'.")

;; Syntax Propertization
;; ============================================================================

(defun tjp--put-syntax (beg end syntax)
  "Give the text between BEG and END the syntax class SYNTAX."
  (put-text-property beg end 'syntax-table (string-to-syntax syntax)))

(defun tjp--propertize-scissors (open-pos)
  "Mark the scissors string starting at OPEN-POS as a generic string.
OPEN-POS is the position of the first character of the `-8<-' mark.  The
opening and closing marks are included in the string so that nothing
inside the block is parsed as code.  Point is left after the block."
  (tjp--put-syntax open-pos (1+ open-pos) "|")
  (goto-char (1+ open-pos))
  (if (re-search-forward "->8\\(-\\)" nil t)
      (progn
        (tjp--put-syntax (match-beginning 1) (match-end 1) "|")
        (goto-char (match-end 1)))
    (goto-char (point-max))))

(defun tjp--balanced-p (beg end regexp open-char)
  "Return non-nil if the delimiters matched by REGEXP balance between BEG and END.
OPEN-CHAR is the character that opens a nesting level."
  (let ((depth 0))
    (save-excursion
      (goto-char beg)
      (while (re-search-forward regexp end t)
        (setq depth (+ depth (if (eq (char-before) open-char) 1 -1)))))
    (zerop depth)))

(defun tjp--neutralize (beg end regexp)
  "Give every match of REGEXP between BEG and END punctuation syntax."
  (save-excursion
    (goto-char beg)
    (while (re-search-forward regexp end t)
      (tjp--put-syntax (match-beginning 0) (match-end 0) "."))))

(defun tjp--propertize-macro-body (open-pos)
  "Neutralize unbalanced brackets in the macro body opened at OPEN-POS.
Macro bodies routinely contain half of a block (that is what makes them
useful), and those stray braces would otherwise be counted as real
nesting by `syntax-ppss' and shift the indentation of everything that
follows.  Balanced bodies are left alone so that they still indent
naturally.  Point is left after the body."
  (let* ((body-beg (1+ open-pos))
         (body-end (save-excursion
                     (goto-char body-beg)
                     (if (re-search-forward "\\][ \t]*$" nil t)
                         (match-beginning 0)
                       (point-max)))))
    (unless (tjp--balanced-p body-beg body-end "[{}]" ?{)
      (tjp--neutralize body-beg body-end "[{}]"))
    (unless (tjp--balanced-p body-beg body-end "[][]" ?\[)
      (tjp--neutralize body-beg body-end "[][]"))
    (goto-char (min (point-max) (1+ body-end)))))

(defconst tjp--syntax-propertize-rules
  (syntax-propertize-rules
   ;; Scissors string.  Per the TJ3 scanner the opening mark must be the
   ;; last thing on its line.
   ("\\(-\\)8<-[ \t]*$"
    (1 (ignore (tjp--propertize-scissors (match-beginning 1)))))
   ;; macro NAME [ ... ]
   ("^[ \t]*macro[ \t]+[A-Za-z_][A-Za-z0-9_]*[ \t]*\\(\\[\\)"
    (1 (ignore (tjp--propertize-macro-body (match-beginning 1))))))
  "Syntax propertization rules for `tjp-mode'.")

(defun tjp-syntax-propertize (start end)
  "Apply TaskJuggler syntax properties between START and END."
  (goto-char start)
  (funcall tjp--syntax-propertize-rules start end))

;; Indentation
;; ============================================================================

(defun tjp--in-string-or-comment-p (&optional pos)
  "Return non-nil if POS (default point) is inside a string or comment.
Point and the match data are preserved: this is called from the middle
of search loops, and `syntax-ppss' may run `syntax-propertize', which
moves point and performs searches of its own."
  (save-excursion
    (save-match-data
      (nth 8 (syntax-ppss (or pos (point)))))))

(defun tjp--in-string-p (&optional pos)
  "Return non-nil if POS (default point) is inside a string.
Guarded like `tjp--in-string-or-comment-p'."
  (save-excursion
    (save-match-data
      (nth 3 (syntax-ppss (or pos (point)))))))

(defun tjp--nesting-depth (&optional pos)
  "Return the bracket nesting depth at POS (default point)."
  (save-excursion
    (save-match-data
      (car (syntax-ppss (or pos (point)))))))

(defun tjp--calculate-indent ()
  "Return the column the current line should be indented to.
Indentation is derived from the brace/bracket nesting depth reported by
`syntax-ppss', so it is robust to blank lines, multi-brace lines and
arbitrary nesting.  A line that begins with a closing brace is dedented
one level so it lines up with the construct that opened it.  Returns nil
for a line that lies inside a multi-line string, whose layout is
significant to tj3 and must not be rewritten."
  (save-excursion
    (beginning-of-line)
    (unless (tjp--in-string-or-comment-p (point))
      (let ((depth (tjp--nesting-depth (point))))
        (when (looking-at "[ \t]*[]}]")
          (setq depth (1- depth)))
        (* (max 0 depth) tjp-indent-offset)))))

(defun tjp-indent-line ()
  "Indent current line as TaskJuggler code.
Lines inside a `-8<- ... ->8-' string are left untouched: their
indentation is part of the string value."
  (interactive)
  (let ((indent (tjp--calculate-indent)))
    (cond
     ((null indent) 'noindent)
     ;; Point is in the leading whitespace: reindent and land on the text.
     ((<= (current-column) (current-indentation))
      (indent-line-to indent))
     ;; Point is inside the text: keep it there while fixing indentation.
     (t (save-excursion (indent-line-to indent))))))

;; ============================================================================
;; TAG NAVIGATION & XREF BACKEND
;; ============================================================================

(defcustom tjp-project-file nil
  "The master `.tjp' file this buffer belongs to, or nil for the buffer itself.
tj3 only accepts a project file whose name ends in `.tjp', so an include
file cannot be compiled or checked on its own.  Set this - typically in
`.dir-locals.el' - to the master project file and `tjp-compile',
`tjp-compile-and-view' and `tjp-validate-buffer' will act on it.  It is
also the file that ID scanning starts from, so IDs defined anywhere in
the project become available to xref and completion:

  ;; .dir-locals.el
  ((tjp-mode . ((tjp-project-file . \"project.tjp\"))))

A relative name is looked for in the current file's directory and then
in each directory above it."
  :type '(choice (const :tag "This buffer" nil) (file :tag "Project file"))
  :safe 'stringp
  :group 'tjp)

(defcustom tjp-follow-includes t
  "When non-nil, xref and completion scan transitively `include'd files.
This lets you jump to and complete task/resource IDs defined in other
files of a multi-file TaskJuggler project."
  :type 'boolean
  :group 'tjp)

(defcustom tjp-cache-ttl 2.0
  "Seconds a scan of the project is reused before it is refreshed.
The scan is redone immediately whenever the buffer changes; this only
bounds how long a stale scan of unchanged `include'd files can survive."
  :type 'number
  :group 'tjp)

(defvar-local tjp--xref-cache nil
  "Cache of task/resource definitions for the xref backend and completion.")

(defvar-local tjp--xref-cache-state nil
  "State the cache in `tjp--xref-cache' was built from.
A cons of the buffer's modification tick and the time of the scan.")

(defvar tjp--file-scan-cache (make-hash-table :test 'equal)
  "Memoized scans of on-disk included files.
Keyed by truename; each value is (MTIME . SCAN), where SCAN is the result
of `tjp--scan-defs-in-buffer'.  Files open in a live buffer are never
memoized here so unsaved edits are always reflected.")

(defconst tjp--definition-regexp
  (concat "^[ \t]*\\(task\\|resource\\|account\\|macro\\|shift\\|scenario\\)[ \t]+"
          ;; In TaskJuggler the ID is optional (`task \"Name\" { ... }' is
          ;; legal and gets a generated ID) and the name is mandatory, except
          ;; for macros, which have an ID and no name.
          "\\(?:\\([A-Za-z_][A-Za-z0-9_]*\\)[ \t]*\\)?"
          "\\(?:\"\\([^\"]*\\)\"[ \t]*\\)?"
          ;; Macro bodies open with `[', other blocks with `{', and a
          ;; definition may also carry no block at all or open it on the
          ;; following line.
          "\\(?:[][{]\\|$\\)")
  "Regexp matching a property definition header.
Group 1 is the keyword, group 2 the optional ID, group 3 the optional name.")

(defun tjp--prepare-scan-buffer ()
  "Give the current temporary buffer just enough of `tjp-mode' to be scanned."
  (set-syntax-table tjp-mode-syntax-table)
  (setq-local parse-sexp-lookup-properties t)
  (setq-local syntax-propertize-function #'tjp-syntax-propertize))

(defun tjp--scan-defs-in-buffer (file)
  "Scan the current buffer for definitions and includes.
Returns (DEFS . INCLUDES).  DEFS is a list of
\(ID TYPE LINE COL POS FILE NAME) entries, where ID is nil for a
definition written without one and NAME is nil for a macro.  INCLUDES is
a list of absolute paths of `include'd files resolved relative to FILE's
directory."
  (let ((defs '())
        (includes '())
        (dir (file-name-directory (or file ""))))
    (save-excursion
      (goto-char (point-min))
      (while (re-search-forward tjp--definition-regexp nil t)
        (let* ((id (match-string-no-properties 2))
               (anchor (or (match-beginning 2) (match-beginning 1))))
          (unless (tjp--in-string-or-comment-p (match-beginning 1))
            (push (list id
                        (match-string-no-properties 1)
                        (line-number-at-pos anchor)
                        (save-excursion (goto-char anchor) (current-column))
                        anchor
                        file
                        (match-string-no-properties 3))
                  defs))))
      (goto-char (point-min))
      (while (re-search-forward "^[ \t]*include[ \t]+\"\\([^\"]+\\)\"" nil t)
        (unless (tjp--in-string-or-comment-p (match-beginning 0))
          (push (expand-file-name (match-string-no-properties 1) dir) includes))))
    (cons (nreverse defs) (nreverse includes))))

(defun tjp--scan-file (file)
  "Return (DEFS . INCLUDES) for FILE.
Uses the live buffer if FILE is being visited; otherwise reads it from
disk, memoizing the scan by modification time in `tjp--file-scan-cache'."
  (let ((buf (find-buffer-visiting file)))
    (if buf
        (with-current-buffer buf (tjp--scan-defs-in-buffer file))
      (let* ((abs (file-truename file))
             (mtime (file-attribute-modification-time (file-attributes file)))
             (cached (gethash abs tjp--file-scan-cache)))
        (if (and cached (equal (car cached) mtime))
            (cdr cached)
          (let ((scan (with-temp-buffer
                        (tjp--prepare-scan-buffer)
                        (insert-file-contents file)
                        (tjp--scan-defs-in-buffer file))))
            (puthash abs (cons mtime scan) tjp--file-scan-cache)
            scan))))))

(defun tjp--collect-all-defs (file visited)
  "Recursively collect definitions from FILE following `include's.
VISITED is a hash table of already-scanned truenames for cycle detection."
  (let ((abs (file-truename file)))
    (when (and (file-readable-p file) (not (gethash abs visited)))
      (puthash abs t visited)
      (let ((scan (tjp--scan-file file)))
        (append (car scan)
                (mapcan (lambda (inc) (tjp--collect-all-defs inc visited))
                        (cdr scan)))))))

(defun tjp--project-file ()
  "Return the master project file for this buffer.
That is `tjp-project-file' when set, and the visited file otherwise.  A
relative `tjp-project-file' is looked for in the buffer's directory and
then in each directory above it, so one `.dir-locals.el' at the root of
the project works for includes in subdirectories."
  (if (and tjp-project-file (not (string-empty-p tjp-project-file)))
      (if (file-name-absolute-p tjp-project-file)
          tjp-project-file
        (let* ((dir (if buffer-file-name
                        (file-name-directory buffer-file-name)
                      default-directory))
               (name tjp-project-file)
               (root (locate-dominating-file
                      dir
                      (lambda (candidate)
                        (file-exists-p (expand-file-name name candidate))))))
          (expand-file-name name (or root dir))))
    buffer-file-name))

(defun tjp--collect-defs ()
  "Scan the project and return every definition that carries an ID."
  (let* ((root (tjp--project-file))
         (visited (make-hash-table :test 'equal))
         (defs (when (and tjp-follow-includes root (file-readable-p root))
                 (tjp--collect-all-defs root visited))))
    ;; Always add this buffer's own definitions.  It may be an include file
    ;; the master does not reach, or may not have been saved yet.
    (unless (and buffer-file-name
                 (gethash (file-truename buffer-file-name) visited))
      (setq defs (append (car (tjp--scan-defs-in-buffer buffer-file-name))
                         defs)))
    ;; Definitions without an ID cannot be referenced, so they are not
    ;; navigation targets; `imenu' and the structure browser still list them.
    (seq-filter #'car defs)))

(defun tjp--update-xref-cache (&optional force)
  "Make sure `tjp--xref-cache' is current, rescanning the project if needed.
The scan is reused while the buffer is unmodified and less than
`tjp-cache-ttl' seconds old, which keeps completion cheap in large
projects.  With FORCE non-nil, always rescan."
  (let ((tick (buffer-chars-modified-tick))
        (now (float-time)))
    (when (or force
              (null tjp--xref-cache-state)
              (/= (car tjp--xref-cache-state) tick)
              (> (- now (cdr tjp--xref-cache-state)) tjp-cache-ttl))
      (setq tjp--xref-cache (tjp--collect-defs))
      (setq tjp--xref-cache-state (cons tick now)))
    tjp--xref-cache))

(defun tjp--get-id-at-point ()
  "Get the hierarchical ID at point (e.g., `project.phase.task')."
  (let ((bounds (bounds-of-thing-at-point 'symbol)))
    (when bounds
      (buffer-substring-no-properties (car bounds) (cdr bounds)))))

(defun tjp--find-id-in-cache (id)
  "Find ID in the xref cache, resolving hierarchical references.
An exact match wins.  Otherwise `a.b.c' resolves to the definition of
its last component, and a query resolves to a definition whose own ID
ends in `.ID'.  A bare suffix match is deliberately not accepted: `ev'
must not silently resolve to `dev'."
  (when (and id (not (string-empty-p id)))
    (or (cl-find id tjp--xref-cache :key #'car :test #'string=)
        (let ((leaf (car (last (split-string id "\\." t)))))
          (and leaf (not (string= leaf id))
               (cl-find leaf tjp--xref-cache :key #'car :test #'string=)))
        (cl-find-if (lambda (entry)
                      (string-suffix-p (concat "." id) (car entry)))
                    tjp--xref-cache))))

(defun tjp-xref-backend ()
  "TaskJuggler xref backend function."
  'tjp)

(cl-defmethod xref-backend-identifier-at-point ((_backend (eql tjp)))
  "Return the identifier at point."
  (tjp--get-id-at-point))

(cl-defmethod xref-backend-definitions ((_backend (eql tjp)) identifier)
  "Find definitions of IDENTIFIER."
  (tjp--update-xref-cache)
  (let ((entry (tjp--find-id-in-cache identifier)))
    (when entry
      (cl-destructuring-bind (id type line col _pos file &optional name) entry
        (list (xref-make (if name
                             (format "%s %s \"%s\"" type id name)
                           (format "%s %s" type id))
                         (xref-make-file-location file line col)))))))

(cl-defmethod xref-backend-identifier-completion-table ((_backend (eql tjp)))
  "Return completion table for identifiers."
  (tjp--update-xref-cache)
  (mapcar #'car tjp--xref-cache))

;; ============================================================================
;; IMENU SUPPORT
;; ============================================================================

(defconst tjp--index-regexp
  (concat "^[ \t]*\\("
          (regexp-opt (append '("task" "resource" "account" "macro")
                              tjp--report-keywords))
          "\\)[ \t]+"
          "\\(?:\\([A-Za-z_][A-Za-z0-9_]*\\)[ \t]*\\)?"
          "\\(?:\"\\([^\"]*\\)\"[ \t]*\\)?"
          "\\(?:[][{]\\|$\\)")
  "Regexp matching anything worth listing in `imenu' or the structure browser.
Group 1 is the keyword, group 2 the optional ID, group 3 the optional name.")

(defun tjp--definition-label (id name)
  "Return a display label for a definition with ID and NAME, either may be nil."
  (cond ((and id name) (format "%s (%s)" id name))
        (id id)
        (name (format "\"%s\"" name))
        (t "<unnamed>")))

(defun tjp--imenu-create-index ()
  "Create imenu index for TaskJuggler buffer.
Definitions written without an ID - which TaskJuggler allows, since only
the name is mandatory - are listed under their name."
  (let ((index-alist '())
        (tasks '())
        (resources '())
        (accounts '())
        (reports '())
        (macros '()))
    (save-excursion
      (goto-char (point-min))
      (while (re-search-forward tjp--index-regexp nil t)
        (let* ((type (match-string-no-properties 1))
               (id (match-string-no-properties 2))
               (name (match-string-no-properties 3))
               (label (tjp--definition-label id name))
               (pos (match-beginning 0)))
          (unless (tjp--in-string-or-comment-p pos)
            (cond
             ((string= type "task")
              (push (cons label pos) tasks))
             ((string= type "resource")
              (push (cons label pos) resources))
             ((string= type "account")
              (push (cons label pos) accounts))
             ((string= type "macro")
              (push (cons label pos) macros))
             ((member type tjp--report-keywords)
              (push (cons label pos) reports)))))))

    (when tasks
      (push (cons "Tasks" (nreverse tasks)) index-alist))
    (when resources
      (push (cons "Resources" (nreverse resources)) index-alist))
    (when accounts
      (push (cons "Accounts" (nreverse accounts)) index-alist))
    (when macros
      (push (cons "Macros" (nreverse macros)) index-alist))
    (when reports
      (push (cons "Reports" (nreverse reports)) index-alist))

    (nreverse index-alist)))

;; ============================================================================
;; ELDOC SUPPORT (Show hierarchical ID in minibuffer)
;; ============================================================================

(defun tjp--get-hierarchical-id ()
  "Get the full hierarchical ID of the current task/resource."
  (save-excursion
    (let ((ids '())
          (current-level 999))
      (while (and (> (point) (point-min))
                  (re-search-backward
                   "^\\s-*\\(task\\|resource\\|account\\)\\s-+\\([a-zA-Z0-9_.]+\\)"
                   nil t))
        (let ((indent (current-indentation))
              (id (match-string 2)))
          (when (< indent current-level)
            (push id ids)
            (setq current-level indent))))
      (when ids
        (mapconcat #'identity ids ".")))))

(defun tjp--on-definition-id-p ()
  "Return non-nil if point is on the ID of a definition line.
A definition line is one introduced by task/resource/account/macro."
  (save-excursion
    (let ((pt (point)))
      (beginning-of-line)
      (and (re-search-forward
            "\\s-*\\(?:task\\|resource\\|account\\|macro\\)\\s-+\\([a-zA-Z0-9_.]+\\)"
            (line-end-position) t)
           (>= pt (match-beginning 1))
           (<= pt (match-end 1))))))

(defun tjp-eldoc-function (&rest _)
  "Provide eldoc documentation for TaskJuggler."
  (let ((keyword (tjp--get-id-at-point)))
    (cond
     ;; Show keyword type when point is over a known keyword.
     ((and keyword (member keyword tjp-properties))
      (format "Property: %s" keyword))
     ((and keyword (member keyword tjp-attributes))
      (format "Attribute: %s" keyword))
     ;; Only show the hierarchical ID when point is on the definition's ID,
     ;; otherwise this would shadow the keyword hints above everywhere below
     ;; the first task in the file.
     ((tjp--on-definition-id-p)
      (let ((hier-id (tjp--get-hierarchical-id)))
        (when hier-id
          (format "Hierarchical ID: %s" hier-id))))
     (t nil))))

;; ============================================================================
;; ID COMPLETION AT POINT (with company-mode support)
;; ============================================================================

(defun tjp-completion-at-point ()
  "Completion at point for TaskJuggler keywords and known IDs."
  (let ((bounds (or (bounds-of-thing-at-point 'symbol)
                    (cons (point) (point)))))
    (unless (tjp--in-string-or-comment-p (car bounds))
      (tjp--update-xref-cache)
      (let ((collection (append (mapcar #'car tjp--xref-cache)
                                tjp--all-keywords)))
        (when collection
          (list (car bounds)
                (cdr bounds)
                collection
                :annotation-function
                (lambda (cand)
                  (let ((entry (tjp--find-id-in-cache cand)))
                    (cond
                     (entry (format " <%s>" (cadr entry)))
                     ((member cand tjp-properties) " <property>")
                     ((member cand tjp-special-keywords) " <keyword>")
                     ((member cand tjp-attributes) " <attribute>"))))
                :company-docsig
                (lambda (cand)
                  (let ((entry (tjp--find-id-in-cache cand)))
                    (when entry
                      (format "%s [Line %d]" (cadr entry) (caddr entry)))))
                :exclusive 'no))))))

;; ============================================================================
;; CONTEXT-SENSITIVE HELP (tj3man integration)
;; ============================================================================

(defun tjp--help-keyword ()
  "Return the keyword to document: the one at point, or one read from the user."
  (let ((at-point (tjp--get-id-at-point)))
    (if (member at-point tjp--all-keywords)
        at-point
      (completing-read "TJ3 keyword: " tjp--all-keywords nil nil
                       (and at-point
                            (string-match-p "\\`[a-z][a-z0-9]*\\'" at-point)
                            at-point)))))

(defun tjp-show-help (&optional keyword)
  "Show TaskJuggler documentation for KEYWORD, or the keyword at point.
Falls back to the online manual when `tjp-man-command' cannot be found."
  (interactive)
  (let* ((keyword (or keyword (tjp--help-keyword)))
         (program (tjp--resolve-command tjp-man-command)))
    (if program
        (let ((buffer (get-buffer-create "*tj3man*")))
          (with-current-buffer buffer
            (let ((inhibit-read-only t))
              (erase-buffer)
              ;; --silent drops the eight line version banner.
              (call-process program nil t nil "--silent" keyword)
              (goto-char (point-min)))
            (help-mode))
          (display-buffer buffer))
      (browse-url (format "https://taskjuggler.org/tj3/manual/%s.html" keyword)))))

;; ============================================================================
;; ADVANCED FOLDING SUPPORT
;; ============================================================================

(defun tjp-setup-hideshow ()
  "Configure hideshow-mode for TaskJuggler."
  ;; Remove any existing tjp-mode entry first
  (setq hs-special-modes-alist
        (assq-delete-all 'tjp-mode hs-special-modes-alist))
  ;; Add our configuration.  Both kinds of block are foldable: `{ ... }' for
  ;; properties and reports, `[ ... ]' for macro bodies.
  (add-to-list 'hs-special-modes-alist
               '(tjp-mode
                 "[[{]"        ; Block start
                 "[]}]"        ; Block end
                 "#\\|//"       ; Comment start
                 nil           ; forward-sexp-func
                 nil)))        ; adjust-beg-func

(defun tjp--block-opener-position ()
  "Return the position of the block opener governing point, or nil.
That is the `{' or `[' later on the current line if there is one - so
that point on a definition header folds that definition - and otherwise
the innermost bracket point is inside of.  Brackets in comments and
strings are ignored, since `syntax-ppss' does the looking."
  (save-excursion
    (let ((eol (line-end-position))
          (opener nil))
      (save-excursion
        (while (and (not opener)
                    (re-search-forward "[[{]" eol t))
          (unless (tjp--in-string-or-comment-p (1- (point)))
            (setq opener (1- (point))))))
      (or opener (save-match-data (nth 1 (syntax-ppss)))))))

(defun tjp-toggle-fold ()
  "Toggle folding of the block at or around point."
  (interactive)
  (if (not (bound-and-true-p hs-minor-mode))
      (message "Hideshow mode not enabled")
    (condition-case err
        (if (cl-some (lambda (ov) (eq (overlay-get ov 'invisible) 'hs))
                     (overlays-at (point)))
            (hs-show-block)
          (let ((opener (tjp--block-opener-position)))
            (if (not opener)
                (message "No block found at point")
              (save-excursion
                (goto-char opener)
                (hs-toggle-hiding)))))
      (error
       (message "Error toggling fold: %s" (error-message-string err))))))

(defun tjp-fold-all ()
  "Fold all blocks in the buffer (brace-aware)."
  (interactive)
  (if (bound-and-true-p hs-minor-mode)
      (hs-hide-all)
    (message "Hideshow mode not enabled")))

(defun tjp-unfold-all ()
  "Unfold all blocks in the buffer."
  (interactive)
  (if (bound-and-true-p hs-minor-mode)
      (hs-show-all)
    (message "Hideshow mode not enabled")))

;; ============================================================================
;; ENHANCED ERROR NAVIGATION
;; ============================================================================

(defvar tjp-error-regexp-alist
  '((tjp-error "^\\([^:]+\\):\\([0-9]+\\): Error: \\(.*\\)$" 1 2 nil 2 1)
    (tjp-warning "^\\([^:]+\\):\\([0-9]+\\): Warning: \\(.*\\)$" 1 2 nil 1 1)
    (tjp-info "^\\([^:]+\\):\\([0-9]+\\): Info: \\(.*\\)$" 1 2 nil 0 1))
  "Regexp patterns for TaskJuggler error messages.")

(defun tjp-setup-compilation ()
  "Setup compilation mode for TaskJuggler."
  (add-to-list 'compilation-error-regexp-alist-alist
               '(tjp-error "^\\([^:]+\\):\\([0-9]+\\): Error:" 1 2 nil 2 1))
  (add-to-list 'compilation-error-regexp-alist-alist
               '(tjp-warning "^\\([^:]+\\):\\([0-9]+\\): Warning:" 1 2 nil 1 1))
  (add-to-list 'compilation-error-regexp-alist-alist
               '(tjp-info "^\\([^:]+\\):\\([0-9]+\\): Info:" 1 2 nil 0 1))

  (add-to-list 'compilation-error-regexp-alist 'tjp-error)
  (add-to-list 'compilation-error-regexp-alist 'tjp-warning)
  (add-to-list 'compilation-error-regexp-alist 'tjp-info))

;; Optional: Flycheck integration (if flycheck is available)
(defvar tjp--flycheck-defined nil
  "Non-nil once the tjp flycheck checker has been defined.")

(defun tjp-setup-flycheck ()
  "Define a flycheck checker for TaskJuggler, once, if flycheck is loaded.
The checker runs on the saved file rather than on a temporary copy: tj3
rejects any name that does not end in `.tjp' and resolves `include's
relative to the file's own directory, so a copy in a temporary directory
could not be checked."
  (when (and (not tjp--flycheck-defined)
             (featurep 'flycheck)
             (fboundp 'flycheck-define-command-checker))
    (setq tjp--flycheck-defined t)
    (funcall 'flycheck-define-command-checker 'tjp
             "A TaskJuggler syntax checker using tj3."
             :command '((eval (or (tjp--resolve-command tjp-compiler-command)
                                  tjp-compiler-command))
                        "--silent" "--no-color" "--check-syntax"
                        (eval (tjp--project-file)))
             :error-patterns
             '((error line-start (file-name) ":" line ": Error: " (message) line-end)
               (warning line-start (file-name) ":" line ": Warning: " (message) line-end)
               (info line-start (file-name) ":" line ": Info: " (message) line-end))
             :predicate (lambda ()
                          (let ((file (tjp--project-file)))
                            (and file
                                 (string-suffix-p ".tjp" file)
                                 (file-exists-p file)
                                 (not (buffer-modified-p)))))
             :modes '(tjp-mode))
    (when (boundp 'flycheck-checkers)
      (add-to-list 'flycheck-checkers 'tjp))))

;; ============================================================================
;; TAGFILE GENERATION
;; ============================================================================

(defun tjp--etags-section (file)
  "Return the TAGS section describing FILE, or nil when it defines nothing.
`etags' has no TaskJuggler support, so the table is written from this
mode's own scan, in the format `etags.el' expects."
  (with-temp-buffer
    (tjp--prepare-scan-buffer)
    (insert-file-contents file)
    (let ((entries '()))
      (goto-char (point-min))
      (while (re-search-forward tjp--index-regexp nil t)
        (let ((id (match-string-no-properties 2))
              (bol (line-beginning-position)))
          (when (and id (not (tjp--in-string-or-comment-p (match-beginning 1))))
            (push (format "%s\177%s\001%d,%d\n"
                          (buffer-substring-no-properties bol (match-end 2))
                          id
                          (line-number-at-pos (match-beginning 1))
                          (1- (position-bytes bol)))
                  entries))))
      (when entries
        (let ((body (apply #'concat (nreverse entries))))
          (format "\f\n%s,%d\n%s" file (string-bytes body) body))))))

(defun tjp-generate-tags ()
  "Write an Emacs TAGS table for this project and visit it.
Note that `M-.' already works without a tags table: `tjp-mode' provides
an xref backend that indexes the project directly.  This command is for
tools outside Emacs, or for including TaskJuggler IDs in a table shared
with other languages."
  (interactive)
  (let* ((project (or (tjp--project-file)
                      (user-error "Buffer is not visiting a file; save it first")))
         (tags-file (expand-file-name "TAGS" (file-name-directory project)))
         (sections (delq nil (mapcar #'tjp--etags-section (tjp--project-files)))))
    (if (null sections)
        (message "No TaskJuggler definitions found")
      (with-temp-file tags-file
        (apply #'insert sections))
      (visit-tags-table tags-file)
      (message "Wrote %s (%d file%s)" tags-file (length sections)
               (if (= 1 (length sections)) "" "s")))))

;; ============================================================================
;; INCLUDE FILE NAVIGATION
;; ============================================================================

(defun tjp--include-at-point ()
  "Return the absolute path of the file `include'd on this line, or nil."
  (save-excursion
    (save-match-data
      (beginning-of-line)
      (when (re-search-forward "include[ \t]+\"\\([^\"]+\\)\"" (line-end-position) t)
        (expand-file-name (match-string-no-properties 1)
                          (if buffer-file-name
                              (file-name-directory buffer-file-name)
                            default-directory))))))

(defun tjp-find-include-at-point ()
  "Jump to the include file named on the current line.
Note that the search and the jump are kept apart: `save-excursion'
restores the current buffer as well as point, so visiting the file from
inside one would land you straight back where you started."
  (interactive)
  (let ((file (tjp--include-at-point)))
    (cond
     ((null file) (message "No include statement on current line"))
     ((file-exists-p file) (find-file file))
     (t (message "Include file not found: %s" file)))))

