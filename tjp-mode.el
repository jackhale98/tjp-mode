;; REPORT BUFFERS (structure, dependencies, allocation, statistics)
;; ============================================================================

(defvar tjp-nav-button-map
  (let ((map (make-sparse-keymap)))
    (define-key map [mouse-1] #'tjp--nav-button-action)
    (define-key map (kbd "RET") #'tjp--nav-button-action)
    map)
  "Keymap for clickable task links.")

(define-derived-mode tjp-report-mode special-mode "TJ Report"
  "Major mode for the TaskJuggler structure, dependency and statistics buffers."
  (setq-local truncate-lines t))

(defmacro tjp--with-report-buffer (name &rest body)
  "Erase the report buffer NAME, run BODY in it and display it read-only."
  (declare (indent 1) (debug (form body)))
  `(let ((buffer (get-buffer-create ,name)))
     (with-current-buffer buffer
       (unless (derived-mode-p 'tjp-report-mode) (tjp-report-mode))
       (let ((inhibit-read-only t))
         (erase-buffer)
         ,@body
         (goto-char (point-min))))
     (display-buffer buffer)
     buffer))

;; ============================================================================
;; HIERARCHICAL STRUCTURE BROWSER
;; ============================================================================

(defun tjp--make-clickable-definition (label line source-buffer)
  "Return LABEL as a link to LINE of SOURCE-BUFFER."
  (propertize label
              'face 'font-lock-function-name-face
              'mouse-face 'highlight
              'tjp-line line
              'tjp-source-buffer source-buffer
              'help-echo "mouse-1: jump to definition"
              'keymap tjp-nav-button-map))

(defun tjp--structure-tag (type)
  "Return the short label the structure browser uses for TYPE."
  (cond ((string= type "task") "task")
        ((string= type "resource") "res")
        ((string= type "account") "acct")
        ((string= type "macro") "macro")
        ((member type tjp--report-keywords) "report")
        (t type)))

(defun tjp-show-structure ()
  "Show the project structure in a side window with clickable links.
Definitions written without an ID are listed under their name."
  (interactive)
  (let ((source-buffer (current-buffer))
        (source-file (buffer-file-name))
        (entries '()))
    (save-excursion
      (goto-char (point-min))
      (while (re-search-forward tjp--index-regexp nil t)
        (let* ((type (match-string-no-properties 1))
               (id (match-string-no-properties 2))
               (name (match-string-no-properties 3))
               (start (match-beginning 0)))
          (unless (tjp--in-string-or-comment-p start)
            (push (list (save-excursion (goto-char start) (current-indentation))
                        type id name
                        (line-number-at-pos start))
                  entries)))))
    (setq entries (nreverse entries))
    (let ((buffer (get-buffer-create "*TJ Structure*")))
      (with-current-buffer buffer
        (unless (derived-mode-p 'tjp-report-mode) (tjp-report-mode))
        (let ((inhibit-read-only t))
          (erase-buffer)
          (insert (format "TaskJuggler Structure: %s\n"
                          (if source-file (file-name-nondirectory source-file) "untitled")))
          (insert "Press RET or click to jump to a definition, q to quit.\n\n")
          (if (null entries)
              (insert "No definitions found in this file.\n")
            (dolist (entry entries)
              (cl-destructuring-bind (indent type id name line) entry
                (insert (make-string (/ indent tjp-indent-offset) ?\s))
                (insert (propertize (format "%-7s" (tjp--structure-tag type))
                                    'face 'font-lock-keyword-face))
                (insert (tjp--make-clickable-definition
                         (tjp--definition-label id name) line source-buffer))
                (insert (format "  %s%d\n"
                                (propertize ":" 'face 'shadow)
                                line)))))
          (goto-char (point-min))))
      (display-buffer buffer
                      '((display-buffer-in-side-window)
                        (side . right)
                        (window-width . 50)))
      buffer)))

;; ============================================================================
;; MACRO EXPANSION AND NAVIGATION
;; ============================================================================

(defun tjp--find-macro (name)
  "Return (START BODY-START BODY-END) for the macro called NAME, or nil.
The body runs to the first `]' that ends a line, which is how the tj3
scanner delimits it, so brackets inside the body do not cut it short."
  (save-excursion
    (save-match-data
      (goto-char (point-min))
      (when (re-search-forward
             (format "^[ \t]*macro[ \t]+%s[ \t]*\\[" (regexp-quote name))
             nil t)
        (let ((start (match-beginning 0))
              (body-start (point)))
          (list start body-start
                (if (re-search-forward "\\][ \t]*$" nil t)
                    (match-beginning 0)
                  (point-max))))))))

(defun tjp-expand-macro-at-point ()
  "Show the body of the macro named at point."
  (interactive)
  (let ((name (tjp--get-id-at-point)))
    (if (null name)
        (message "No macro at point")
      (let ((macro (tjp--find-macro name)))
        (if (null macro)
            (message "Macro definition not found: %s" name)
          (message "Macro %s expands to: %s" name
                   (string-trim (buffer-substring-no-properties
                                 (nth 1 macro) (nth 2 macro)))))))))

(defun tjp-find-macro-definition ()
  "Jump to the definition of the macro named at point."
  (interactive)
  (let ((name (tjp--get-id-at-point)))
    (if (null name)
        (message "No macro at point")
      (let ((macro (tjp--find-macro name)))
        (if macro
            (progn (push-mark) (goto-char (nth 0 macro)))
          (message "Macro not found: %s" name))))))

;; ============================================================================
;; DEPENDENCY VISUALIZATION
;; ============================================================================

(defun tjp--get-current-task ()
  "Get the ID of the current task context.
Searches backward from point to find the enclosing task definition."
  (save-excursion
    ;; Move to beginning of line to ensure we capture full task ID
    ;; even if point is in the middle of the task line
    (end-of-line)
    (when (re-search-backward "^\\s-*task\\s-+\\([a-zA-Z0-9_.]+\\)" nil t)
      (match-string-no-properties 1))))

(defun tjp--build-task-location-map ()
  "Build a hash table mapping task IDs to their line numbers.
Returns a hash table where keys are task IDs and values are line numbers.
Stores both the simple ID and the full hierarchical ID for each task."
  (let ((loc-map (make-hash-table :test 'equal))
        (id-stack '()))
    (save-excursion
      (goto-char (point-min))
      (while (re-search-forward
              "^\\(\\s-*\\)task\\s-+\\([a-zA-Z0-9_.]+\\)"
              nil t)
        (let* ((indent (length (match-string 1)))
               (task-id (match-string-no-properties 2))
               (line (line-number-at-pos (match-beginning 0))))
          ;; Pop stack to find parent at lower indent level
          (while (and id-stack (>= (caar id-stack) indent))
            (pop id-stack))
          ;; Build hierarchical ID
          (let ((hier-id (if id-stack
                            (concat (cdar id-stack) "." task-id)
                          task-id)))
            ;; Store both simple and hierarchical IDs
            (puthash task-id line loc-map)
            (unless (string= task-id hier-id)
              (puthash hier-id line loc-map))
            ;; Push current task onto stack
            (push (cons indent hier-id) id-stack)))))
    loc-map))

(defun tjp--lookup-task-line (task-id loc-map)
  "Look up line number for TASK-ID in LOC-MAP.
Tries exact match first, then tries matching the last component
of hierarchical IDs."
  (or (gethash task-id loc-map)
      ;; Try matching just the last component (simple ID)
      (let ((simple-id (car (last (split-string task-id "\\.")))))
        (gethash simple-id loc-map))
      ;; Try finding any key that ends with this ID
      (let ((found nil))
        (maphash (lambda (key val)
                   (when (and (not found)
                              (or (string-suffix-p (concat "." task-id) key)
                                  (string= task-id key)))
                     (setq found val)))
                 loc-map)
        found)))

(defun tjp--make-clickable-task (task-id line source-buffer)
  "Create a clickable text for TASK-ID at LINE in SOURCE-BUFFER."
  (propertize (format "%s:%d" task-id line)
              'face 'font-lock-function-name-face
              'mouse-face 'highlight
              'tjp-task-id task-id
              'tjp-line line
              'tjp-source-buffer source-buffer
              'help-echo "mouse-1: jump to task definition"
              'keymap tjp-nav-button-map))

(defun tjp--nav-button-action (&optional event)
  "Jump to the task definition at point or mouse EVENT."
  (interactive (list last-input-event))
  (when event
    (mouse-set-point event))
  (let ((source-buffer (get-text-property (point) 'tjp-source-buffer))
        (line (get-text-property (point) 'tjp-line)))
    (when (and source-buffer line)
      (pop-to-buffer source-buffer)
      (goto-char (point-min))
      (forward-line (1- line))
      (back-to-indentation))))

(defun tjp--build-dependency-map ()
  "Build a hash table mapping task IDs to their direct dependencies.
Returns a hash table where keys are task IDs and values are lists
of dependency IDs. Note: the `!' prefix in TaskJuggler indicates
relative task references, not dependency type."
  (let ((deps-map (make-hash-table :test 'equal)))
    (save-excursion
      (goto-char (point-min))
      (while (re-search-forward
              "depends\\s-+\\([a-zA-Z0-9_.!, {}]+\\)"
              nil t)
        (let ((deps-string (match-string 1))
              (task (tjp--get-current-task)))
          (when task
            ;; Handle comma-separated dependencies, strip modifiers like { gapduration 2d }
            (let ((clean-deps (replace-regexp-in-string "{[^}]*}" "" deps-string)))
              (dolist (dep (split-string clean-deps "[,]" t "\\s-*"))
                (let* ((dep-clean (string-trim dep))
                       ;; Remove ! prefix (relative reference) to get base ID
                       (dep-id (replace-regexp-in-string "^!+" "" dep-clean)))
                  (when (not (string-empty-p dep-id))
                    (push dep-id (gethash task deps-map))))))))))
    deps-map))

(defun tjp--get-dependency-chain (task deps-map visited)
  "Recursively get the dependency chain for TASK.
DEPS-MAP is the hash table of dependencies.
VISITED is a list of already-visited tasks (to detect cycles).
Returns a nested list structure representing the dependency tree."
  (if (member task visited)
      (list task "(cycle detected)")
    (let ((deps (gethash task deps-map)))
      (if deps
          (cons task
                (mapcar (lambda (dep-id)
                          (tjp--get-dependency-chain
                           dep-id deps-map (cons task visited)))
                        deps))
        (list task)))))

(defun tjp--insert-dependency-tree (tree indent loc-map source-buffer)
  "Insert TREE into current buffer with proper indentation.
INDENT is the current indentation level.
LOC-MAP maps task IDs to line numbers.
SOURCE-BUFFER is the original TJP buffer for navigation."
  (let ((task (car tree))
        (deps (cdr tree))
        (prefix (make-string (* indent 2) ?\s)))
    ;; Insert task with clickable link
    (let ((line (tjp--lookup-task-line task loc-map)))
      (insert prefix)
      (if line
          (insert (tjp--make-clickable-task task line source-buffer))
        (insert (propertize task 'face 'font-lock-function-name-face)))
      (insert "\n"))
    ;; Insert dependencies
    (dolist (dep deps)
      (if (stringp dep)
          ;; Cycle detected marker
          (insert (format "%s  %s\n" prefix
                         (propertize dep 'face 'font-lock-warning-face)))
        ;; dep is a subtree (list starting with task id)
        (insert (format "%s  └── " prefix))
        ;; Insert subtree inline (remove leading whitespace from first line)
        (let ((start (point)))
          (tjp--insert-dependency-tree dep (+ indent 2) loc-map source-buffer)
          ;; Remove the extra indentation from first line of subtree
          (save-excursion
            (goto-char start)
            (when (looking-at (make-string (* (+ indent 2) 2) ?\s))
              (delete-char (* (+ indent 2) 2)))))))))

(defun tjp-show-dependencies ()
  "Show the full dependency chain for the task at point."
  (interactive)
  (let ((current-task (tjp--get-current-task))
        (source-buffer (current-buffer))
        (source-file (buffer-file-name)))

    (if (not current-task)
        (message "No task found at point")

      (let* ((deps-buffer (get-buffer-create "*TJ Dependencies*"))
             (deps-map (tjp--build-dependency-map))
             (loc-map (tjp--build-task-location-map))
             (chain (tjp--get-dependency-chain current-task deps-map nil)))

        (with-current-buffer deps-buffer
          (unless (derived-mode-p 'tjp-report-mode) (tjp-report-mode))
          (let ((inhibit-read-only t))
          (erase-buffer)
          (insert (format "Dependency Chain - %s\n"
                         (if source-file (file-name-nondirectory source-file) "untitled")))
          (insert "=====================================\n\n")

          (if (null (cdr chain))
              (let ((line (tjp--lookup-task-line current-task loc-map)))
                (if line
                    (insert (tjp--make-clickable-task current-task line source-buffer))
                  (insert (propertize current-task 'face 'font-lock-function-name-face)))
                (insert " has no dependencies.\n"))
            (tjp--insert-dependency-tree chain 0 loc-map source-buffer))

          (insert "\nPress RET or click on a task to jump to its definition.\n")
          (goto-char (point-min))))

        (display-buffer deps-buffer)))))

;; ============================================================================
;; RESOURCE ALLOCATION DISPLAY
;; ============================================================================

(defun tjp-show-resource-allocation ()
  "Show resource allocation summary."
  (interactive)
  (let ((alloc-buffer (get-buffer-create "*TJ Resource Allocation*"))
        (allocations (make-hash-table :test 'equal))
        (source-file (buffer-file-name)))

    (save-excursion
      (goto-char (point-min))
      (while (re-search-forward
              "allocate\\s-+\\([a-zA-Z0-9_.]+\\)"
              nil t)
        (let ((resource (match-string 1))
              (task (tjp--get-current-task)))
          (when task
            (push task (gethash resource allocations))))))

    (with-current-buffer alloc-buffer
      (unless (derived-mode-p 'tjp-report-mode) (tjp-report-mode))
      (let ((inhibit-read-only t))
      (erase-buffer)
      (insert (format "Resource Allocations - %s\n"
                     (if source-file (file-name-nondirectory source-file) "untitled")))
      (insert "=====================================\n\n")

      (if (zerop (hash-table-count allocations))
          (insert "No resource allocations found in this file.\n")
        (maphash (lambda (resource tasks)
                   (insert (format "%s is allocated to:\n"
                                 (propertize resource 'face 'font-lock-variable-name-face)))
                   (dolist (task tasks)
                     (insert (format "  - %s\n"
                                   (propertize task 'face 'font-lock-function-name-face))))
                   (insert "\n"))
                 allocations))

      (goto-char (point-min))))

    (display-buffer alloc-buffer)))

;; ============================================================================
;; LIVE SYNTAX VALIDATION
;; ============================================================================

(defun tjp-validate-buffer ()
  "Check the project's syntax with tj3.
Runs asynchronously in a compilation buffer, so errors are clickable and
Emacs stays responsive."
  (interactive)
  (let ((command (tjp--build-command "--check-syntax")))
    (tjp--save-project-buffers)
    (tjp--run command (lambda (_mode) "*TJ Validation*"))))

(defun tjp-validate-on-save ()
  "Validate buffer on save if `tjp-auto-validate' is non-nil."
  (when tjp-auto-validate
    (tjp-validate-buffer)))

;; ============================================================================
;; PROJECT STATISTICS
;; ============================================================================

(defconst tjp--effort-regexp
  "^[ \t]*effort[ \t]+\\([0-9.]+\\)[ \t]*\\(min\\|[hdwmy]\\)\\_>"
  "Regexp matching an `effort' attribute and its unit.")

(defun tjp--project-number (keyword default)
  "Return the number given to project attribute KEYWORD, or DEFAULT."
  (save-excursion
    (goto-char (point-min))
    (if (re-search-forward
         (format "^[ \t]*%s[ \t]+\\([0-9.]+\\)" (regexp-quote keyword)) nil t)
        (string-to-number (match-string 1))
      default)))

(defun tjp--effort-days (value unit hours-per-day days-per-year)
  "Convert VALUE of UNIT into working days.
tj3 derives all effort units from `dailyworkinghours' (HOURS-PER-DAY) and
`yearlyworkingdays' (DAYS-PER-YEAR); the same factors are used here."
  (pcase unit
    ("min" (/ value 60.0 hours-per-day))
    ("h" (/ value hours-per-day))
    ("d" value)
    ("w" (* value (/ days-per-year 52.1428)))
    ("m" (* value (/ days-per-year 12.0)))
    ("y" (* value days-per-year))
    (_ 0.0)))

(defun tjp--count-matches (regexp)
  "Count matches of REGEXP outside strings and comments."
  (let ((count 0))
    (save-excursion
      (goto-char (point-min))
      (while (re-search-forward regexp nil t)
        (unless (tjp--in-string-or-comment-p (match-beginning 0))
          (setq count (1+ count)))))
    count))

(defun tjp-show-statistics ()
  "Show a rough size estimate for the project in this buffer."
  (interactive)
  (let* ((source-file (buffer-file-name))
         (hours-per-day (tjp--project-number "dailyworkinghours" 8.0))
         (days-per-year (tjp--project-number "yearlyworkingdays" 260.714))
         (days-per-week (/ days-per-year 52.1428))
         (days-per-month (/ days-per-year 12.0))
         (counts (list (cons "Tasks" 0) (cons "Resources" 0) (cons "Accounts" 0)
                       (cons "Macros" 0) (cons "Reports" 0)))
         (milestones (tjp--count-matches "^[ \t]*milestone\\_>"))
         (total-effort 0.0))
    (save-excursion
      (goto-char (point-min))
      (while (re-search-forward tjp--index-regexp nil t)
        (let ((type (match-string-no-properties 1)))
          (unless (tjp--in-string-or-comment-p (match-beginning 0))
            (let ((key (cond ((string= type "task") "Tasks")
                             ((string= type "resource") "Resources")
                             ((string= type "account") "Accounts")
                             ((string= type "macro") "Macros")
                             ((member type tjp--report-keywords) "Reports"))))
              (when key
                (cl-incf (cdr (assoc key counts))))))))
      (goto-char (point-min))
      (while (re-search-forward tjp--effort-regexp nil t)
        (unless (tjp--in-string-or-comment-p (match-beginning 0))
          (setq total-effort
                (+ total-effort
                   (tjp--effort-days (string-to-number (match-string 1))
                                     (match-string 2)
                                     hours-per-day days-per-year))))))
    (tjp--with-report-buffer "*TJ Statistics*"
      (insert "Project Statistics\n")
      (insert (format "File: %s\n\n"
                      (if source-file (file-name-nondirectory source-file) "untitled")))
      (insert "=====================================\n\n")
      (dolist (entry counts)
        (insert (format "%-20s %6d\n" (concat (car entry) ":") (cdr entry))))
      (insert (format "%-20s %6d\n" "Milestones:" milestones))
      (insert "\n")
      (insert (format "%-20s %6.1f days\n" "Total effort:" total-effort))
      (insert (format "%-20s %6.1f weeks\n" "" (/ total-effort days-per-week)))
      (insert (format "%-20s %6.1f months\n" "" (/ total-effort days-per-month)))
      (insert "\n")
      (insert (format "Estimated from the `effort' attributes in this file only,\n"))
      (insert (format "at %g working hours per day and %g working days per year.\n"
                      hours-per-day days-per-year)))))

;; ============================================================================
;; OUTLINE MODE INTEGRATION
;; ============================================================================

(defun tjp-setup-outline ()
  "Setup outline-mode patterns for TaskJuggler."
  (setq-local outline-regexp
              (concat "^\\s-*\\("
                     (regexp-opt '("project" "task" "resource" 
                                  "account" "report" "scenario" "macro"))
                     "\\)"))
  (setq-local outline-level
              (lambda ()
                (save-excursion
                  (looking-at outline-regexp)
                  (1+ (/ (current-indentation) tjp-indent-offset))))))

;; ============================================================================
;; NAVIGATION HELPERS
;; ============================================================================

(defconst tjp--block-motion-regexp
  (concat "^[ \t]*\\(" (regexp-opt tjp-structural-keywords) "\\)[ \t]+")
  "Regexp matching the start of a property definition, for block motion.")

(defun tjp--goto-block (direction)
  "Move to the next definition in DIRECTION, which is 1 or -1.
Returns non-nil when point moved."
  (let ((search (if (> direction 0) #'re-search-forward #'re-search-backward))
        (start (point))
        (found nil))
    (if (> direction 0) (end-of-line) (beginning-of-line))
    (while (and (not found)
                (funcall search tjp--block-motion-regexp nil t))
      (if (tjp--in-string-or-comment-p (match-beginning 1))
          nil
        (setq found (match-beginning 1))))
    (if found
        (progn (goto-char found) (back-to-indentation) t)
      (goto-char start)
      nil)))

(defun tjp-next-block ()
  "Move to the next task/resource/report definition."
  (interactive)
  (unless (tjp--goto-block 1)
    (message "No more blocks")))

(defun tjp-previous-block ()
  "Move to the previous task/resource/report definition."
  (interactive)
  (unless (tjp--goto-block -1)
    (message "No previous blocks")))

;; ============================================================================
;; COMPILATION SUPPORT
;; ============================================================================

(defvar-local tjp--auto-compile-command nil
  "The `compile-command' this mode computed, used to detect user overrides.")

(defun tjp--compile-target ()
  "Return the .tjp file tj3 should be run on, or signal a user error.
tj3 refuses any input file that does not end in `.tjp', so an include
file has to name its master project in `tjp-project-file'."
  (let ((file (tjp--project-file)))
    (cond
     ((null file)
      (user-error "Buffer is not visiting a file; save it first"))
     ((not (string-suffix-p ".tjp" file))
      (user-error "tj3 only accepts a .tjp file: set `tjp-project-file' to the master project of %s"
                  (file-name-nondirectory file)))
     ((not (file-exists-p file))
      (user-error "Project file does not exist: %s" file))
     (t file))))

(defun tjp--compiler ()
  "Return the absolute path of the tj3 executable, or signal a user error."
  (or (tjp--resolve-command tjp-compiler-command)
      (user-error "Cannot find `%s'.  Set `tjp-compiler-command' to its absolute path"
                  tjp-compiler-command)))

(defun tjp--build-command (&rest args)
  "Return a shell command running tj3 with ARGS on the project file."
  ;; Resolve the target first: "this buffer has no file" is a more useful
  ;; complaint than "I cannot find tj3".
  (let ((target (tjp--compile-target)))
    (mapconcat #'shell-quote-argument
               (append (list (tjp--compiler) "--silent" "--no-color")
                       args
                       (list target))
               " ")))

(defun tjp--effective-compile-command ()
  "Return the command `tjp-compile' should run.
A `compile-command' set by the user or by `.dir-locals.el' wins; otherwise
the command is derived from `tjp-compiler-command' and the project file."
  (if (and tjp--auto-compile-command
           (not (equal compile-command tjp--auto-compile-command)))
      compile-command
    (let ((command (tjp--build-command)))
      (setq tjp--auto-compile-command command)
      (setq-local compile-command command)
      command)))

(defun tjp--save-project-buffers ()
  "Save every modified TaskJuggler buffer, since tj3 reads includes from disk."
  (save-some-buffers t (lambda () (derived-mode-p 'tjp-mode))))

(defun tjp--run (command &optional name-function)
  "Run COMMAND in a compilation buffer rooted at the project directory.
NAME-FUNCTION, if given, names the buffer as for `compilation-start'."
  (let ((default-directory (file-name-directory (tjp--compile-target))))
    (compilation-start command nil name-function)))

(defun tjp-compile ()
  "Compile the current TaskJuggler project with tj3."
  (interactive)
  ;; Resolve the target before saving: a buffer without a file must not be
  ;; turned into a "where should I save this?" prompt.
  (let ((command (tjp--effective-compile-command)))
    (tjp--save-project-buffers)
    (tjp--run command)))

(defun tjp--project-files ()
  "Return every file of the project, master first, following `include's."
  (let ((visited (make-hash-table :test 'equal))
        (files '()))
    (cl-labels ((walk (file)
                  (let ((abs (and file (file-truename file))))
                    (when (and file (file-readable-p file) (not (gethash abs visited)))
                      (puthash abs t visited)
                      (push file files)
                      (mapc #'walk (cdr (tjp--scan-file file)))))))
      (walk (tjp--project-file)))
    (nreverse files)))

(defun tjp--output-dir ()
  "Return the directory tj3 writes reports into.
Honours a project-level `outputdir', defaulting to the project directory."
  (let* ((project (or (tjp--project-file) (buffer-file-name)))
         (base (if project (file-name-directory project) default-directory))
         (dir base))
    (catch 'found
      (dolist (file (tjp--project-files) dir)
        (with-temp-buffer
          (tjp--prepare-scan-buffer)
          (insert-file-contents file)
          (goto-char (point-min))
          (when (re-search-forward "^[ \t]*outputdir[ \t]+\"\\([^\"]+\\)\"" nil t)
            (throw 'found
                   (file-name-as-directory
                    (expand-file-name (match-string-no-properties 1) base)))))))))

(defconst tjp--report-header-regexp
  (concat "^[ \t]*\\(" (regexp-opt tjp--report-keywords) "\\)[ \t]+"
          ;; `report [<id>] <name>': the ID is optional, the name is not, and
          ;; it is the name - not the ID - that becomes the output file name.
          "\\(?:\\([A-Za-z_][A-Za-z0-9_]*\\)[ \t]+\\)?"
          "\"\\([^\"]*\\)\"[ \t]*{")
  "Regexp matching a report definition that opens a block.
Group 1 is the report type, group 2 the optional ID, group 3 the name.")

(defun tjp--block-declares-html-p (open-brace)
  "Return non-nil if the block whose `{' is at OPEN-BRACE asks for HTML output."
  (save-excursion
    (let ((end (ignore-errors (scan-lists open-brace 1 0))))
      (goto-char (1+ open-brace))
      (and end
           (re-search-forward "^[ \t]*formats[ \t]+\\([^\n}]*\\)" end t)
           (string-match-p "\\_<html\\_>" (match-string-no-properties 1))))))

(defun tjp--scan-reports-in-buffer (file)
  "Return the HTML reports defined in the current buffer.
Each entry is (TYPE ID NAME FILE)."
  (let ((reports '()))
    (save-excursion
      (goto-char (point-min))
      (while (re-search-forward tjp--report-header-regexp nil t)
        (let ((type (match-string-no-properties 1))
              (id (match-string-no-properties 2))
              (name (match-string-no-properties 3))
              (brace (1- (match-end 0))))
          (when (and (not (tjp--in-string-or-comment-p (match-beginning 0)))
                     (tjp--block-declares-html-p brace))
            (push (list type id name file) reports)))))
    (nreverse reports)))

(defun tjp--html-reports ()
  "Return every report in the project that generates HTML output."
  (let ((reports '()))
    (dolist (file (tjp--project-files) (nreverse reports))
      (let ((buffer (find-buffer-visiting file)))
        (dolist (report (if buffer
                            (with-current-buffer buffer
                              (tjp--scan-reports-in-buffer file))
                          (with-temp-buffer
                            (tjp--prepare-scan-buffer)
                            (insert-file-contents file)
                            (tjp--scan-reports-in-buffer file))))
          (push report reports))))))

(defun tjp--report-output-file (report)
  "Return the file tj3 writes REPORT to.
A report name that starts with a slash is an absolute file name; every
other name is relative to the project's `outputdir'."
  (let ((name (nth 2 report)))
    (concat (if (file-name-absolute-p name)
                name
              (expand-file-name name (tjp--output-dir)))
            ".html")))

(defun tjp--read-report (reports)
  "Ask the user to pick one of REPORTS."
  (let* ((choices (mapcar (lambda (r)
                            (cons (format "%s %s(%s)"
                                          (nth 0 r)
                                          (if (nth 1 r) (concat (nth 1 r) " ") "")
                                          (nth 2 r))
                                  r))
                          reports))
         (choice (completing-read "Report: " choices nil t)))
    (cdr (assoc choice choices))))

(defun tjp--compile-then (command callback)
  "Run COMMAND with `compile' and call CALLBACK once it finishes successfully."
  (let (finish-fn)
    (setq finish-fn
          (lambda (buffer status)
            (remove-hook 'compilation-finish-functions finish-fn)
            (when (and (buffer-live-p buffer)
                       (string-match-p "finished" status))
              (funcall callback))))
    (add-hook 'compilation-finish-functions finish-fn)
    (tjp--run command)))

(defun tjp-compile-and-view ()
  "Compile the project and open a report's HTML output.
The output file name comes from the report's name - the quoted string,
which is what tj3 uses as the base name - and the project's `outputdir'.
When the project defines more than one HTML report you are asked which
one to open.  The file is opened only after compilation succeeds."
  (interactive)
  (let* ((command (tjp--effective-compile-command))
         (reports (tjp--html-reports))
         (report (cond
                  ((null reports)
                   (user-error "No report with `formats html' found in this project"))
                  ((null (cdr reports)) (car reports))
                  (t (tjp--read-report reports))))
         (html-file (tjp--report-output-file report)))
    (tjp--save-project-buffers)
    (tjp--compile-then
     command
     (lambda ()
       (if (file-exists-p html-file)
           (browse-url-of-file html-file)
         (message "Report output not found: %s" html-file))))))

;; ============================================================================
;; HELPER FUNCTIONS
;; ============================================================================

(defcustom tjp-cleanup-whitespace-on-save t
  "When non-nil, delete trailing whitespace from the buffer on save.
Whitespace inside a multi-line string is never touched: there it is part
of the value tj3 reads."
  :type 'boolean
  :group 'tjp)

(defun tjp-cleanup-whitespace ()
  "Delete trailing whitespace outside strings, if enabled.
See `tjp-cleanup-whitespace-on-save'."
  (when (and (derived-mode-p 'tjp-mode) tjp-cleanup-whitespace-on-save)
    (save-excursion
      (goto-char (point-min))
      (while (re-search-forward "[ \t]+$" nil t)
        (unless (tjp--in-string-p (match-beginning 0))
          (delete-region (match-beginning 0) (match-end 0)))))))

(defun tjp--prepare-insertion-point ()
  "Move point onto a clean line ready to receive a new block.
If the current line already has content, open a fresh line just below the
enclosing statement.  Returns the column the new block should start at,
derived from the current brace-nesting depth so the block nests correctly
inside the surrounding task/resource/report."
  (let ((depth (tjp--nesting-depth (line-beginning-position))))
    (if (save-excursion (beginning-of-line) (looking-at-p "[ \t]*$"))
        ;; Reuse the current blank line, clearing any stray whitespace.
        (progn (beginning-of-line)
               (delete-region (point) (line-end-position)))
      ;; Otherwise open a fresh line after the current statement.
      (end-of-line)
      (newline))
    (* (max 0 depth) tjp-indent-offset)))

(defun tjp--insert-block (header body-lines)
  "Insert a TaskJuggler block at point and leave point inside it.
HEADER is the text before the opening brace (e.g. \"task foo \\\"Foo\\\"\").
BODY-LINES is a list of strings placed inside the block; when nil a single
empty, indented line is left for the user to type on.  Point ends at the end
of the first body line."
  (let* ((indent (tjp--prepare-insertion-point))
         (pad (make-string indent ?\s))
         (ipad (make-string (+ indent tjp-indent-offset) ?\s))
         (lines (or body-lines '("")))
         body-start)
    (insert pad header " {\n")
    (setq body-start (point))
    (dolist (line lines)
      (insert ipad line "\n"))
    (insert pad "}\n")
    (goto-char body-start)
    (end-of-line)))

(defun tjp--read-name (prompt)
  "Read a non-empty name with PROMPT.
TaskJuggler makes the name mandatory and the ID optional, not the other
way round: `task \"Design\" { ... }' is valid, `task design { ... }' is
not."
  (let ((name ""))
    (while (string-empty-p (setq name (string-trim (read-string prompt))))
      (minibuffer-message "A name is required"))
    name))

(defun tjp--block-header (keyword id name)
  "Build a block header string for KEYWORD with optional ID and NAME."
  (if (or (null id) (string-empty-p id))
      (format "%s \"%s\"" keyword name)
    (format "%s %s \"%s\"" keyword id name)))

(defun tjp-insert-task ()
  "Insert a task at point, nested correctly inside any enclosing block."
  (interactive)
  (let* ((name (tjp--read-name "Task name: "))
         (id (string-trim (read-string "Task ID (optional): "))))
    (tjp--insert-block (tjp--block-header "task" id name) nil)))

(defun tjp-insert-resource ()
  "Insert a resource at point, nested correctly inside any enclosing block."
  (interactive)
  (let* ((name (tjp--read-name "Resource name: "))
         (id (string-trim (read-string "Resource ID (optional): "))))
    (tjp--insert-block (tjp--block-header "resource" id name) nil)))

(defun tjp-insert-report ()
  "Insert a report at point, choosing the type and seeding sensible defaults."
  (interactive)
  (let* ((type (completing-read
                "Report type: "
                tjp--report-keywords nil t nil nil "taskreport"))
         ;; The report name is what tj3 uses as the base name of the output
         ;; file, so "Project Overview" produces "Project Overview.html".
         (name (tjp--read-name "Report name (becomes the output file name): "))
         (id (string-trim (read-string "Report ID (optional): ")))
         (body (pcase type
                 ("taskreport"
                  '("formats html"
                    "columns name, start, end, effort, chart"
                    "loadunit days"))
                 ("resourcereport"
                  '("formats html"
                    "columns name, effort"
                    "loadunit days"))
                 ("accountreport"
                  '("formats html"
                    "columns name, total"))
                 ("textreport"
                  '("formats html"
                    "text \"\""))
                 ("export"
                  '("formats tjp"))
                 (_
                  '("formats html")))))
    (tjp--insert-block (tjp--block-header type id name) body)))

